# Modelia configuration
# Copy this file to `.env` in the repository root. Do not commit `.env`.
#
# Use this same file location on every machine:
# - Local computer: keep the local values below.
# - Production VM: replace the values marked "VM" with your real domain and secrets.

# --- Public application ----------------------------------------------------
# Local: localhost. VM: your DuckDNS domain without https://.
APP_DOMAIN=localhost
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Django ----------------------------------------------------------------
# VM: generate a private value with `openssl rand -hex 32`.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
TRUST_X_FORWARDED_PROTO=False

# --- MongoDB (Modelia's own database) ---------------------------------------
# The mongo compose service is a single-node replica set with no user and no
# published port; only the containers on the compose network can reach it.
# These are the defaults, so they only need setting to point somewhere else.
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=modelia
MONGO_REPLICA_SET=rs0

# --- Redis -----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- Browser session and CSRF ----------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=True
CSRF_TRUSTED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
FRONTEND_BASE_URL=http://localhost:3000

# --- Email -----------------------------------------------------------------
# Local development uses the Mailpit service from docker-compose.yml.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@modelia.local

# --- Generated backend runner ----------------------------------------------
# Required. Generate a private value with `openssl rand -hex 32`.
RUNNER_TOKEN=
RUNNER_URL=http://runner:8090
RUNNER_TIMEOUT_SECONDS=15
RUNNER_BIND=127.0.0.1:8090
PUBLIC_BASE_URL=http://localhost:8090
DEPLOYMENT_MAX_ACTIVE_PER_ORG=2

# Days a mobile app login token stays valid (logout revokes it sooner).
MOBILE_TOKEN_TTL_DAYS=30

# Optional runner limits. Leave empty to use the runner defaults.
RUNNER_BUILD_IMAGE=
RUNNER_RUNTIME_IMAGE=
RUNNER_POSTGRES_IMAGE=
RUNNER_BUILD_MEM=
RUNNER_APP_MEM=
RUNNER_DB_MEM=
RUNNER_BUILD_CPUS=
RUNNER_APP_CPUS=
RUNNER_DB_CPUS=
RUNNER_MAX_LIFETIME_SECONDS=
RUNNER_BUILD_TIMEOUT=
RUNNER_START_TIMEOUT=
RUNNER_MAX_ZIP_BYTES=
RUNNER_JPA_DDL_AUTO=

# --- Voice-driven diagram assistant -----------------------------------------
# Optional. Leave empty until you have a real key for whichever provider
# LLM_PROVIDER selects; the voice-command endpoint answers a clear error
# (not a crash) until the selected provider's key is set.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional local model: set LLM_PROVIDER=local and point at any
# OpenAI-compatible server (Ollama, vLLM, llama.cpp). With the bundled
# `ollama` compose service (start it with `--profile local-ai`) the URL is
# http://ollama:11434/v1 and the model is whichever you pulled with
# `docker compose exec ollama ollama pull <model>`. The key is usually not
# needed.
LOCAL_LLM_BASE_URL=
# Recommended starting model (tested with Modelia; ~2.5 GB, runs on CPU):
# LOCAL_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
# Seconds to wait for one local answer (default 120). A CPU-only EC2 instance
# needs a generous value; there are no retries for the local provider.
LOCAL_LLM_TIMEOUT_SECONDS=120
# How long Ollama keeps the model in memory after a request (compose `ollama`
# service). Loading it takes seconds to minutes, so keep it warm on the server.
OLLAMA_KEEP_ALIVE=30m

# Push notifications for the mobile app (optional). Path to the Firebase service-account
# JSON, kept OUTSIDE git (backend/secrets/ is ignored). In dev the backend folder is mounted
# at /app, so backend/secrets/firebase-credentials.json is /app/secrets/firebase-credentials.json.
# Empty = no pushes.
FIREBASE_CREDENTIALS_PATH=

# Semantic memory of the team chat: the embedding model that turns a message into a vector of
# its meaning. Used with LLM_PROVIDER=openai or local (Gemini has none: no memory then).
# With the local provider run once: docker compose exec ollama ollama pull nomic-embed-text
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=nomic-embed-text
# Minimum cosine similarity for a past message to be recalled (0.45 suits OpenAI's
# text-embedding-3-small; tune it when you switch to another embedding model).
CHAT_MEMORY_MIN_SIMILARITY=0.45
