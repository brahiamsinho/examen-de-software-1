# Copy to deploy/.env.prod (git-ignored) and fill in. No real secrets here.
# Used as:  docker compose --env-file deploy/.env.prod -f docker-compose.prod.yml ...

# --- Public host -----------------------------------------------------------
# Your DuckDNS name, no scheme. Caddy gets the HTTPS certificate for it.
APP_DOMAIN=your-name.duckdns.org

# --- Secrets (generate each one with: openssl rand -hex 32) ------------------
SECRET_KEY=
POSTGRES_PASSWORD=
# Shared bearer token backend <-> runner. The runner refuses to start when empty.
RUNNER_TOKEN=

# --- Database (defaults are fine) ---------------------------------------------
POSTGRES_DB=app
POSTGRES_USER=app

# --- Generated backends ----------------------------------------------------------
DEPLOYMENT_MAX_ACTIVE_PER_ORG=2
# Optional runner limits (defaults in runner/app/config.py suit a 4 GB / 2 vCPU VM):
# RUNNER_BUILD_MEM=1536m
# RUNNER_APP_MEM=512m
# RUNNER_MAX_LIFETIME_SECONDS=21600

# --- Outgoing email (verification / password reset) -----------------------------
# Default = console backend: emails only appear in `docker compose logs backend`.
# For real delivery use SMTP, e.g.:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=no-reply@your-name.duckdns.org
