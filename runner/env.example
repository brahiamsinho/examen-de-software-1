# Variables read by docker-compose.yml for the `runner` service (and, for the
# first four, by the backend service too). Put the real values in the ROOT `.env`
# next to docker-compose.yml (git-ignored); Compose substitutes them.

# REQUIRED: shared bearer token between backend and runner. The runner refuses to
# start when it is empty. Generate one:  openssl rand -hex 32
RUNNER_TOKEN=
# Where the runner's published port binds on the host. Keep loopback; in the cloud
# put Caddy in front and route only `/gen/*` to runner:8090.
RUNNER_BIND=127.0.0.1:8090
# Browser-facing origin of `/gen/<id>/...` (Django and the runner both read it).
# Cloud example: https://modelia.duckdns.org
PUBLIC_BASE_URL=http://localhost:8090
# Max concurrently active deployments per organization (Django).
DEPLOYMENT_MAX_ACTIVE_PER_ORG=2

# Optional runner knobs (defaults live in runner/app/config.py):
# RUNNER_BUILD_IMAGE=gradle:9.7.1-jdk21   # keep equal to backend gradle_runner_image()
# RUNNER_RUNTIME_IMAGE=eclipse-temurin:21-jre
# RUNNER_POSTGRES_IMAGE=postgres:16-alpine
# RUNNER_BUILD_MEM=1536m
# RUNNER_APP_MEM=512m
# RUNNER_DB_MEM=256m
# RUNNER_BUILD_CPUS=1.5
# RUNNER_APP_CPUS=1.0
# RUNNER_DB_CPUS=0.5
# RUNNER_MAX_LIFETIME_SECONDS=21600       # TTL: max lifetime of a deployment (6h)
# RUNNER_BUILD_TIMEOUT=900
# RUNNER_START_TIMEOUT=240
# RUNNER_MAX_ZIP_BYTES=5242880
# RUNNER_JPA_DDL_AUTO=update
