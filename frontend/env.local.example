NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL the Next.js *server process* uses to reach the API (server-side
# session checks in `lib/server-session.ts`). Falls back to
# NEXT_PUBLIC_API_URL when unset, so bare `npm run dev` needs nothing here.
# Compose sets this to http://backend:8000 (see docker-compose.yml).
# INTERNAL_API_URL=http://backend:8000
#
# Deployment precondition: server-side route protection only works when the
# browser sends the Django `sessionid` cookie to the Next.js origin. True
# for localhost and same-parent-domain deploys; false for a split
# app.x.com / api.y.com deployment, where every authenticated user would be
# bounced to /login (ssr-protected-routes design.md — Migration/Rollout).
