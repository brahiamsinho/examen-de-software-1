# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env (see docker-compose.yml's backend service comment).

# --- Core ---------------------------------------------------------------
SECRET_KEY=change-me
DEBUG=True
# `backend` (the Compose service name) is required alongside the
# browser-facing hosts: the frontend container's server-side session check
# (ssr-protected-routes) sends `Host: backend:8000` when it calls the API
# from inside the Docker network. docker-compose.yml's `backend.environment`
# already overrides this for `docker compose up`; kept here too so a bare
# `python manage.py runserver` against a copied .env still matches.
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Database (matches the docker-compose `db` service) ------------------
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS -----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Session / CSRF (design.md DD2) ---------------------------------------
# Deployment matrix:
#
# | Environment                | Frontend origin              | *_SAMESITE | *_SECURE | Note                                                          |
# |-----------------------------|-------------------------------|------------|----------|----------------------------------------------------------------|
# | Local dev                  | http://localhost:3000 -> :8000| Lax        | False    | Different ports are still same-site; no HTTPS needed.         |
# | Deployed, different domains| app.example.com -> api.example.com | None  | True     | Browsers reject SameSite=None without Secure; both flip together. |
#
# CSRF_TRUSTED_ORIGINS must list the frontend origin(s) with scheme, e.g.
# https://app.example.com (required by Django whenever the request Origin
# differs from the API's own origin, which is always true for this project).
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# --- Transactional email (email-verification / password-reset) -----------
# Dev values below point at the `mailpit` Compose service (SMTP 1025, web UI
# http://localhost:8025). Unset, each falls back to Django's own default
# (transactional-email spec) — no Mailpit literal lives in settings.py.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@modelia.local

# Base URL the frontend is served from; used to build verification/reset
# links in outgoing emails.
FRONTEND_BASE_URL=http://localhost:3000
